class_name WorldView
extends Node3D
## Doom-style 2.5D view: every map cell is a box with floor, ceiling and walls where there is no
## opening. The enemy is a billboard sprite; the camera is the local player's eyes.

const CELL_SIZE := 2.0
const WALL_HEIGHT := 2.2
const EYE_HEIGHT := 1.05
const ENEMY_HEIGHT := 1.55
const STEP_DURATION := 0.42


## Camera pose on the rails: world position plus yaw (radians, 0 = looking north / -Z).
class Pose:
	var pos: Vector3
	var yaw: float

	func _init(p_pos: Vector3, p_yaw: float) -> void:
		pos = p_pos
		yaw = p_yaw


## When true (in a conflict) the enemy always squares up to us with the front sprite.
var enemy_engaged := false

var _camera: Camera3D
var _torch: OmniLight3D
var _enemy_root: Node3D
var _enemy: Sprite3D
var _front: Texture2D
var _side: Texture2D
var _rear: Texture2D
var _attack: Texture2D
var _enemy_facing := Dirs.NORTH
var _enemy_flash := 0.0
var _enemy_attack_time := 0.0
var _enemy_guard_time := 0.0
var _materialize := 0.0
var _vanished := false
var _puff_tex := TextureFactory.puff()
var _time := 0.0
var _enemy_dead := false
## Doorway mist: [{"a": MapCell, "b": MapCell, "mats": [ShaderMaterial, ...]}], one per open edge.
var _mist: Array = []
var _mist_shader: Shader = preload("res://game/shadow_mist.gdshader")


func _ready() -> void:
	var env := Environment.new()
	env.background_mode = Environment.BG_COLOR
	env.background_color = Color.BLACK
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.ambient_light_color = Color(0.55, 0.5, 0.6)
	env.ambient_light_energy = 0.35
	env.fog_enabled = true
	env.fog_light_color = Color(0.02, 0.01, 0.02)
	env.fog_density = 0.11
	var world_env := WorldEnvironment.new()
	world_env.environment = env
	add_child(world_env)

	_camera = Camera3D.new()
	_camera.fov = 72
	_camera.keep_aspect = Camera3D.KEEP_WIDTH
	_camera.near = 0.05
	_camera.far = 60.0
	_camera.current = true
	add_child(_camera)

	_torch = OmniLight3D.new()
	_torch.light_color = Color(1.0, 0.78, 0.55)
	_torch.light_energy = 1.7
	_torch.omni_range = 9.0
	_torch.omni_attenuation = 1.3
	_torch.position = Vector3(0.2, 0.1, 0.1)
	_camera.add_child(_torch)

	_enemy_root = Node3D.new()
	add_child(_enemy_root)
	# Sprites are generated by tools/process_sprites.gd: same character height, feet centered.
	_front = load("res://assets/sprites/enemy_front.png")
	_side = load("res://assets/sprites/enemy_side.png")
	_rear = load("res://assets/sprites/enemy_rear.png")
	_attack = load("res://assets/sprites/enemy_attack.png")
	_enemy = Sprite3D.new()
	_enemy.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y
	_enemy.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
	_enemy.alpha_cut = SpriteBase3D.ALPHA_CUT_DISCARD
	_enemy.shaded = true
	_enemy.double_sided = true
	_enemy_root.add_child(_enemy)
	_set_enemy_texture(_front)


func _set_enemy_texture(tex: Texture2D) -> void:
	if _enemy.texture == tex:
		return
	_enemy.texture = tex
	_enemy.pixel_size = ENEMY_HEIGHT / tex.get_height()
	# The swing art is feet-centered with the blade arc trailing left; nudge it right so the arc stays on screen.
	var x := tex.get_width() * 0.22 if tex == _attack else 0.0
	_enemy.offset = Vector2(x, tex.get_height() / 2.0)


func build_map(map: DuelMap) -> void:
	var wall := SurfaceTool.new()
	var floor := SurfaceTool.new()
	var ceil := SurfaceTool.new()
	wall.begin(Mesh.PRIMITIVE_TRIANGLES)
	floor.begin(Mesh.PRIMITIVE_TRIANGLES)
	ceil.begin(Mesh.PRIMITIVE_TRIANGLES)

	var h := CELL_SIZE / 2.0
	var uvs := [Vector2(0, 0), Vector2(1, 0), Vector2(1, 1), Vector2(0, 1)]
	for cell in map.cells:
		var c := cell_center(cell)
		var a := c + Vector3(-h, 0, -h)
		var b := c + Vector3(h, 0, -h)
		var d := c + Vector3(h, 0, h)
		var e := c + Vector3(-h, 0, h)
		var up := Vector3.UP * WALL_HEIGHT

		_add_quad(floor, [a, b, d, e], Vector3.UP, Color.WHITE, uvs)
		_add_quad(ceil, [a + up, b + up, d + up, e + up], Vector3.DOWN, Color.WHITE, uvs)

		for dir in 4:
			if cell.is_open(dir):
				continue
			var n := dir_vec(dir)
			var t := dir_vec(Dirs.right(dir))
			var edge := c + n * h
			var p0 := edge - t * h
			var p1 := edge + t * h
			# Doom-style fake contrast: N/S walls slightly darker than E/W.
			var shade := Color(0.78, 0.78, 0.78) if dir in [Dirs.NORTH, Dirs.SOUTH] else Color.WHITE
			_add_quad(wall, [p0 + up, p1 + up, p1, p0], -n, shade, uvs)

	for pair in [[wall, TextureFactory.cave_wall()], [floor, TextureFactory.cave_floor()], [ceil, TextureFactory.cave_ceiling()]]:
		var mi := MeshInstance3D.new()
		mi.mesh = pair[0].commit()
		mi.material_override = _material(pair[1])
		add_child(mi)
	_build_mist(map)


## A curtain of shadow in every doorway. Only doorways between two cells you can see are clear, so
## every side passage visibly swallows the view: if it's misty, you can't see in, and they can't see out.
func _build_mist(map: DuelMap) -> void:
	var quad := QuadMesh.new()
	quad.size = Vector2(CELL_SIZE, WALL_HEIGHT)
	var seen := {}
	for cell in map.cells:
		for dir in 4:
			var other := cell.neighbor(dir)
			if other == null:
				continue
			var key := [cell.get_instance_id(), other.get_instance_id()]
			key.sort()
			if seen.has(key):
				continue
			seen[key] = true
			var n := dir_vec(dir)
			var door := cell_center(cell) + n * CELL_SIZE / 2.0 + Vector3.UP * WALL_HEIGHT / 2.0
			var entry := {"a": cell, "b": other, "mats": []}
			# Two layers a hand apart give the mist a little depth as you walk up to it.
			for layer in [-1, 1]:
				var mat := ShaderMaterial.new()
				mat.shader = _mist_shader
				mat.set_shader_parameter("seed", randf() * 10.0)
				var mi := MeshInstance3D.new()
				mi.mesh = quad
				mi.material_override = mat
				mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
				mi.position = door + n * 0.09 * layer
				mi.rotation.y = yaw_of(dir)
				add_child(mi)
				entry["mats"].append(mat)
			_mist.append(entry)


## Cells the local player can currently see: their own cell plus the straight sight line.
static func visible_cells(s: DuelState, local_id: int) -> Dictionary:
	var me := s.fighters[local_id]
	var out := {me.cell: true}
	for c in DuelMap.sight_line(me.cell, me.facing):
		out[c] = true
	return out


## Fades doorway mist in or out to match what the player can see. 0 seconds snaps.
func set_sight(visible: Dictionary, seconds := 0.0) -> void:
	for entry in _mist:
		var target := 0.0 if visible.has(entry["a"]) and visible.has(entry["b"]) else 1.0
		for mat in entry["mats"]:
			if seconds <= 0.0:
				mat.set_shader_parameter("strength", target)
			else:
				create_tween().tween_property(mat, "shader_parameter/strength", target, seconds)


static func _material(tex: Texture2D) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = tex
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST_WITH_MIPMAPS
	m.vertex_color_use_as_albedo = true
	m.roughness = 1.0
	m.metallic_specular = 0.0
	m.cull_mode = BaseMaterial3D.CULL_DISABLED
	return m


static func _add_quad(st: SurfaceTool, v: Array, normal: Vector3, color: Color, uv: Array) -> void:
	for i in [0, 1, 2, 0, 2, 3]:
		st.set_normal(normal)
		st.set_color(color)
		st.set_uv(uv[i])
		st.add_vertex(v[i])


static func cell_center(c: MapCell) -> Vector3:
	return Vector3(c.col * CELL_SIZE, 0, c.row * CELL_SIZE)


static func dir_vec(d: int) -> Vector3:
	match d:
		Dirs.NORTH: return Vector3(0, 0, -1)
		Dirs.EAST: return Vector3(1, 0, 0)
		Dirs.SOUTH: return Vector3(0, 0, 1)
	return Vector3(-1, 0, 0)


static func yaw_of(d: int) -> float:
	return -d * PI / 2.0


## Where the local player's camera and the enemy sprite should sit for the current state.
## Returns {"cam": Pose, "enemy": Vector3}.
static func poses_for(s: DuelState, local_id: int) -> Dictionary:
	var me := s.fighters[local_id]
	var foe := s.other(local_id)
	var cam_pos := cell_center(me.cell)
	var enemy_pos := cell_center(foe.cell)
	# Keep the face-off framing on the final blow too, instead of snapping back to the cell centre.
	if s.in_conflict or (s.is_over and me.cell == foe.cell):
		if me.cell == foe.cell:
			# Sharing a tile: back up against our side and put the enemy right in our face.
			var fwd := dir_vec(me.facing)
			cam_pos -= fwd * CELL_SIZE * 0.45
			enemy_pos += fwd * CELL_SIZE * 0.4
		else:
			# Bumped in a hallway: both lean toward the shared doorway.
			var to_foe := (enemy_pos - cam_pos).normalized()
			cam_pos += to_foe * CELL_SIZE * 0.25
			enemy_pos -= to_foe * CELL_SIZE * 0.25
	cam_pos.y = EYE_HEIGHT
	return {"cam": Pose.new(cam_pos, yaw_of(me.facing)), "enemy": enemy_pos}


func snap_to(cam: Pose, enemy: Vector3, enemy_facing: int) -> void:
	_apply_camera(cam)
	_enemy_root.position = enemy
	_enemy_facing = enemy_facing


func revive() -> void:
	_enemy_dead = false
	_vanished = false
	_enemy.scale = Vector3.ONE
	_enemy.visible = true


## Plays one resolved tick: glides the camera and enemy along the rails.
func animate(cam_from: Pose, cam_to: Pose, en_from: Vector3, en_to: Vector3, enemy_facing: int,
		cam_bump: bool, enemy_lunge: bool, on_done: Callable) -> void:
	_enemy_facing = enemy_facing
	var cam_moves := cam_from.pos.distance_to(cam_to.pos) > 0.01
	var en_moves := en_from.distance_to(en_to) > 0.01
	var cam_fwd := Vector3(-sin(cam_to.yaw), 0, -cos(cam_to.yaw))

	var tween := create_tween()
	tween.tween_method(func(t: float):
		var arc := sin(PI * t)
		var pos := cam_from.pos.lerp(cam_to.pos, t)
		if cam_moves:
			pos.y -= arc * 0.06
		if cam_bump:
			pos += cam_fwd * arc * CELL_SIZE * 0.3
		_apply_camera(Pose.new(pos, lerp_angle(cam_from.yaw, cam_to.yaw, t)))

		var ep := en_from.lerp(en_to, t)
		if en_moves:
			ep.y += arc * 0.05
		if enemy_lunge:
			var to_cam := _camera.position - ep
			to_cam.y = 0
			if to_cam.length_squared() > 0.0001:
				ep += to_cam.normalized() * arc * CELL_SIZE * 0.1
		_enemy_root.position = ep, 0.0, 1.0, STEP_DURATION).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	tween.finished.connect(on_done)


## Players only see straight ahead, so the sprite is hidden outside the sight line (no peeking around corners).
func set_enemy_visible(value: bool) -> void:
	_enemy_root.visible = value or _enemy_dead


func flash_enemy() -> void:
	_enemy_flash = 1.0


func kill_enemy() -> void:
	_enemy_dead = true
	create_tween().tween_property(_enemy, "scale", Vector3(1.2, 0.05, 1.0), 0.6).set_trans(Tween.TRANS_QUAD)


func _apply_camera(p: Pose) -> void:
	_camera.position = p.pos
	_camera.rotation = Vector3(0, p.yaw, 0)


func _process(delta: float) -> void:
	_time += delta
	_torch.light_energy = 1.7 + sin(_time * 9.0) * 0.05 + sin(_time * 23.0) * 0.04

	_enemy_flash = maxf(0.0, _enemy_flash - delta * 3.0)
	_enemy_attack_time = maxf(0.0, _enemy_attack_time - delta)
	_enemy_guard_time = maxf(0.0, _enemy_guard_time - delta)

	# Pick the directional sprite from the enemy's facing relative to our view.
	var to_cam := _camera.position - _enemy_root.position
	to_cam.y = 0
	var facing := dir_vec(_enemy_facing)
	var dot := facing.dot(to_cam.normalized()) if to_cam.length_squared() > 0.0001 else 1.0
	if _enemy_attack_time > 0.0:
		_set_enemy_texture(_attack)
		_enemy.flip_h = false
	elif enemy_engaged or dot > 0.5:
		_set_enemy_texture(_front)
		_enemy.flip_h = false
	elif dot < -0.5:
		_set_enemy_texture(_rear)
		_enemy.flip_h = false
	else:
		# The side art faces screen-right; mirror it when the enemy faces screen-left.
		_set_enemy_texture(_side)
		_enemy.flip_h = facing.dot(_camera.global_basis.x) < 0.0

	var tint := Color.WHITE
	if _enemy_guard_time > 0.0:
		tint = Color(0.6, 0.8, 1.3)
	if _enemy_dead:
		tint = Color(0.6, 0.15, 0.15)
	_materialize = maxf(0.0, _materialize - delta * 3.0)
	tint = tint.lerp(Color(0.1, 0.05, 0.15), _materialize)
	_enemy.modulate = tint.lerp(Color(1.0, 0.2, 0.2), _enemy_flash)


## Shadow-clone style escape: the sprite bursts into fading afterimages and smoke where it stood,
## so the direction of the flee is never shown.
func vanish() -> void:
	if _vanished:
		return
	_vanished = true
	var origin := _enemy_root.position
	var right := _camera.global_basis.x
	right.y = 0
	right = right.normalized()

	for i in 4:
		var ghost := Sprite3D.new()
		ghost.texture = _enemy.texture
		ghost.flip_h = _enemy.flip_h
		ghost.pixel_size = _enemy.pixel_size
		ghost.offset = _enemy.offset
		ghost.billboard = BaseMaterial3D.BILLBOARD_FIXED_Y
		ghost.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
		ghost.shaded = false
		ghost.alpha_cut = SpriteBase3D.ALPHA_CUT_DISABLED
		ghost.modulate = Color(0.12, 0.05, 0.18, 0.85)
		ghost.position = origin
		add_child(ghost)
		var side := i - 1.5
		var t := ghost.create_tween().set_parallel()
		t.tween_property(ghost, "position", origin + right * side * 0.45 + Vector3.UP * 0.12 * absf(side), 0.4) \
			.set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
		t.tween_property(ghost, "modulate:a", 0.0, 0.4)
		t.tween_property(ghost, "scale", Vector3(0.6, 1.15, 1.0), 0.4)
		t.chain().tween_callback(ghost.queue_free)
	_puffs(origin, right, 8)
	_enemy.visible = false


## Brings a vanished enemy back when it's in sight again, fading in out of shadow.
func reappear() -> void:
	if not _vanished:
		return
	_vanished = false
	_enemy.visible = true
	_materialize = 1.0
	var right := _camera.global_basis.x
	right.y = 0
	_puffs(_enemy_root.position, right.normalized(), 4)


func snap_enemy(pos: Vector3) -> void:
	_enemy_root.position = pos


func _puffs(origin: Vector3, right: Vector3, count: int) -> void:
	for i in count:
		var start := origin + right * (randf() - 0.5) * 0.9 + Vector3.UP * (0.15 + randf() * 1.2)
		var p := Sprite3D.new()
		p.texture = _puff_tex
		p.pixel_size = 0.05
		p.billboard = BaseMaterial3D.BILLBOARD_ENABLED
		p.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
		p.shaded = false
		p.alpha_cut = SpriteBase3D.ALPHA_CUT_DISABLED
		p.modulate = Color(0.35, 0.3, 0.4, 0.9)
		p.position = start
		p.scale = Vector3.ONE * 0.4
		add_child(p)
		var life := 0.45 + randf() * 0.3
		var t := p.create_tween().set_parallel()
		t.tween_property(p, "scale", Vector3.ONE * (1.4 + randf()), life)
		t.tween_property(p, "position", start + Vector3.UP * 0.35 + right * (randf() - 0.5) * 0.4, life)
		t.tween_property(p, "modulate:a", 0.0, life).set_ease(Tween.EASE_IN)
		t.chain().tween_callback(p.queue_free)


## Shows the swing sprite for a moment (attack, ambush, shove).
func show_enemy_attack(seconds := 0.55) -> void:
	_enemy_attack_time = seconds


func show_enemy_guard(seconds := 0.6) -> void:
	_enemy_guard_time = seconds
